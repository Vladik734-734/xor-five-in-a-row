				<Item class="ModuleScript" referent="RBXDB67EBAD389D4DD783802787BA271BBC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local LeaderboardManager = {}


local Players = {}



function LeaderboardManager:AddPlayer(player,data)

	table.insert(
		Players,
		{
			Name = player.Name,

			Rating = data.Rating,

			Wins = data.Wins
		}
	)

end



function LeaderboardManager:Update(player,data)


	for _,entry in Players do

		if entry.Name == player.Name then


			entry.Rating =
				data.Rating


			entry.Wins =
				data.Wins


			return

		end

	end


end




function LeaderboardManager:GetTop(amount)


	table.sort(
		Players,
		function(a,b)

			return a.Rating > b.Rating

		end
	)



	local result={}


	for i=1,
		math.min(amount,#Players)
	do

		table.insert(
			result,
			Players[i]
		)

	end


	return result

end



return LeaderboardManager]]></ProtectedString>
						<string name="ScriptGuid">{358223AC-17C2-4758-805D-4ABAD04DF275}</string>
