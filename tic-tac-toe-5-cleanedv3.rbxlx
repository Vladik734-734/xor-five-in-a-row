					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local InventoryManager = {}


function InventoryManager:Create()

	return {

		Skins = {
			"Default"
		},

		Boards = {
			"Default"
		},

		Effects = {},

		SelectedSkin = "Default",

		SelectedBoard = "Default"

	}

end



function InventoryManager:AddItem(inventory,itemType,item)

	if not inventory[itemType] then
		return false
	end


	table.insert(
		inventory[itemType],
		item
	)


	return true

end




function InventoryManager:HasItem(inventory,itemType,item)


	if not inventory[itemType] then
		return false
	end


	return table.find(
		inventory[itemType],
		item
	) ~= nil


end



return InventoryManager]]></ProtectedString>
