						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local RewardManager = {}



RewardManager.Rewards = {


	Win = {

		Coins = 100,

		Rating = 25

	},


	SecondPlace = {

		Coins = 50,

		Rating = -5

	},


	Lose = {

		Coins = 25,

		Rating = -15

	}


}




function RewardManager:Get(typeName)


	return self.Rewards[typeName]


end



function RewardManager:Give(data,typeName)


	local reward =
		self.Rewards[typeName]


	if not reward then
		return
	end



	data.Coins += reward.Coins


	data.Rating += reward.Rating


end



return RewardManager]]></ProtectedString>
