						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local SkinManager = {}



function SkinManager:Equip(playerData,skin)


	if not playerData.Inventory then
		return false
	end



	if table.find(
		playerData.Inventory.Skins,
		skin
		) then


		playerData.Inventory.SelectedSkin =
			skin


		return true

	end


	return false

end




function SkinManager:GetCurrent(playerData)


	return playerData.Inventory.SelectedSkin


end



return SkinManager]]></ProtectedString>
