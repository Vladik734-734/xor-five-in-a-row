					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Items =
	require(script.Parent.ItemDatabase)


local Validator =
	require(script.Parent.PurchaseValidator)



local Shop={}



function Shop:Buy(playerData,itemName)


	local item =
		Items[itemName]


	if not item then

		return false

	end



	if Validator:CanBuy(playerData,item) then


		playerData.Coins -= item.Price


		playerData.Skin =
			itemName


		return true

	end



	return false

end



function Shop:GetItems()

	return Items

end



return Shop]]></ProtectedString>
