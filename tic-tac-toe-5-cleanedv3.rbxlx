			<Item class="LocalScript" referent="RBX656D4EE9440C4659A9BD772470DDC4D7">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")


local player = Players.LocalPlayer


local mouse = player:GetMouse()



------------------------------------------------
-- REMOTE
------------------------------------------------

local PlaceMove =
	ReplicatedStorage
	.Remotes
	.PlaceMove



------------------------------------------------
-- BOARD
------------------------------------------------

local board =
	workspace:WaitForChild("Board")


local cellsFolder =
	board:WaitForChild("Cells")



------------------------------------------------
-- HIGHLIGHT
------------------------------------------------

local highlight = Instance.new("SelectionBox")


highlight.Name =
	"CellHighlight"


highlight.LineThickness = 0.05


highlight.Color3 =
	Color3.fromRGB(
		0,
		255,
		150
	)


highlight.SurfaceTransparency = 0.7


highlight.Visible = false


highlight.Parent = workspace



local currentCell = nil



------------------------------------------------
-- HOVER
------------------------------------------------

mouse.Move:Connect(function()


	local target =
		mouse.Target



	if target
		and target.Parent == cellsFolder then



		currentCell = target


		highlight.Adornee =
			target


		highlight.Visible = true



	else


		currentCell = nil


		highlight.Visible = false


	end


end)




------------------------------------------------
-- CLICK MOVE
------------------------------------------------

mouse.Button1Down:Connect(function()


	if not currentCell then

		return

	end



	local name =
		currentCell.Name



	local x,z =
		name:match(
			"Cell_(%d+)_(%d+)"
		)



	if x and z then


		x = tonumber(x)
		z = tonumber(z)



		PlaceMove:FireServer(
			x,
			z,
			currentCell.Position
		)


	end



end)]]></ProtectedString>
					<bool name="Disabled">false</bool>
