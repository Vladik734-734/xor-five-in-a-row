	settingsButton.FontFace = Font.new("rbxasset://fonts.families.FredokaOne.json")
	settingsButton.AutoButtonColor = true

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = settingsButton

	settingsButton.Parent = gui
end

local settingsWindow = gui:FindFirstChild("SettingsWindow")
if not settingsWindow then
	settingsWindow = Instance.new("Frame")
	settingsWindow.Name = "SettingsWindow"
	settingsWindow.Size = UDim2.new(0, 320, 0, 220)
	settingsWindow.Position = UDim2.new(0.5, -160, 0.5, -110) -- Центр екрана
	settingsWindow.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	settingsWindow.Visible = false

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = settingsWindow

	-- Заголовок вікна
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, 0, 0, 40)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "Settings"
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextSize = 20
	titleLabel.FontFace = Font.new("rbxasset://fonts.families.FredokaOne.json")
	titleLabel.Parent = settingsWindow

	-- Кнопка закриття (хрестик)
	local closeButton = Instance.new("TextButton")
	closeButton.Name = "CloseButton"
	closeButton.Size = UDim2.new(0, 30, 0, 30)
	closeButton.Position = UDim2.new(1, -35, 0, 5)
	closeButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	closeButton.Text = "X"
	closeButton.TextSize = 16
	closeButton.FontFace = Font.new("rbxasset://fonts.families.FredokaOne.json")

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 6)
	closeCorner.Parent = closeButton
	closeButton.Parent = settingsWindow

	-- Кнопка вибору звуку перемоги
	local winSoundButton = Instance.new("TextButton")
	winSoundButton.Name = "WinSoundButton"
	winSoundButton.Size = UDim2.new(0, 280, 0, 45)
	winSoundButton.Position = UDim2.new(0.5, -140, 0, 60)
	winSoundButton.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
	winSoundButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	winSoundButton.Text = "Win Sound: Classic"
	winSoundButton.TextSize = 14
	winSoundButton.FontFace = Font.new("rbxasset://fonts.families.FredokaOne.json")

	local soundCorner = Instance.new("UICorner")
	soundCorner.CornerRadius = UDim.new(0, 8)
	soundCorner.Parent = winSoundButton
	winSoundButton.Parent = settingsWindow

	-- Випадаюче меню для звуків
	local soundMenu = Instance.new("Frame")
	soundMenu.Name = "SoundMenu"
	soundMenu.Size = UDim2.new(1, 0, 0, 140)
	soundMenu.Position = UDim2.new(0, 0, 1, 5)
	soundMenu.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
	soundMenu.Visible = false

	local menuCorner = Instance.new("UICorner")
	menuCorner.CornerRadius = UDim.new(0, 8)
	menuCorner.Parent = soundMenu

	local uiList = Instance.new("UIListLayout")
	uiList.SortOrder = Enum.SortOrder.LayoutOrder
	uiList.Padding = UDim.new(0, 4)
	uiList.Parent = soundMenu

	local sounds = { "Classic", "Victory", "Epic", "Retro" }
	for i, soundName in ipairs(sounds) do
		local optBtn = Instance.new("TextButton")
		optBtn.Name = soundName
		optBtn.Size = UDim2.new(1, 0, 0, 30)
		optBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
		optBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		optBtn.Text = soundName
		optBtn.TextSize = 14
		optBtn.FontFace = Font.new("rbxasset://fonts.families.FredokaOne.json")
		optBtn.LayoutOrder = i
		optBtn.Parent = soundMenu
	end

	soundMenu.Parent = winSoundButton
	table.insert(allMenus, soundMenu)

	settingsWindow.Parent = gui
end

local closeSettingsButton = settingsWindow:WaitForChild("CloseButton")
local winSoundButton = settingsWindow:WaitForChild("WinSoundButton")

settingsButton.MouseButton1Click:Connect(function()
	settingsWindow.Visible = not settingsWindow.Visible
end)

closeSettingsButton.MouseButton1Click:Connect(function()
	settingsWindow.Visible = false
end)

local function wireWinSoundDropdown(button)
	local menu = button:FindFirstChild("SoundMenu")
	if not menu then return end

	button.MouseButton1Click:Connect(function()
		local willBeVisible = not menu.Visible
		-- Закриваємо всі інші меню перед відкриттям цього
		for _, m in ipairs(allMenus) do
			m.Visible = false
		end
		menu.Visible = willBeVisible
	end)

	for _, optionButton in ipairs(menu:GetChildren()) do
		if optionButton:IsA("TextButton") then
			optionButton.MouseButton1Click:Connect(function()
				SetWinSound:FireServer(optionButton.Name)
				button.Text = "Win Sound: " .. optionButton.Name
				menu.Visible = false
			end)
		end
	end
end

if winSoundButton then
	wireWinSoundDropdown(winSoundButton)
end

------------------------------------------------
-- ЕФЕКТИ ПЕРЕМОГИ
------------------------------------------------

local activeWinTweens = {}

local function playWinEffects(winningPiece, winLine, soundId)
	local board = workspace:FindFirstChild("Board")
	local piecesFolder = board and board:FindFirstChild("Pieces")
	local cellsFolder = board and board:FindFirstChild("Cells")

	if not piecesFolder or not cellsFolder then return end

	local winSound = Instance.new("Sound")
	winSound.SoundId = soundId or "rbxassetid://9114220035"
	winSound.Volume = 1
	winSound.Parent = SoundService
	winSound:Play()
	winSound.Ended:Connect(function()
		winSound:Destroy()
	end)

	for _, pieceModel in ipairs(piecesFolder:GetChildren()) do
		if pieceModel:GetAttribute("PieceType") == winningPiece or pieceModel.Name:find(winningPiece) then

			local modelPos = pieceModel:IsA("Model") and pieceModel:GetPivot().Position or pieceModel.Position
			local matched = false

			for _, coord in ipairs(winLine or {}) do
				local cell = cellsFolder:FindFirstChild("Cell_" .. coord.X .. "_" .. coord.Y)
				if cell and (cell.Position - modelPos).Magnitude < 3 then
					matched = true
					break
				end
			end

			if matched then
				local targetCFrame = pieceModel:IsA("Model") and pieceModel:GetPivot() or pieceModel.CFrame
				local primaryPart = pieceModel:IsA("Model") and pieceModel.PrimaryPart or pieceModel:FindFirstChild("BasePart") or pieceModel
				local emitter = nil

				if primaryPart and primaryPart:IsA("BasePart") then
					emitter = Instance.new("ParticleEmitter")
					emitter.Name = "WinParticles"
					emitter.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
					emitter.Size = NumberSequence.new(0.6, 0)
					emitter.Texture = "rbxassetid://258127463"
					emitter.Rate = 40
					emitter.Lifetime = NumberRange.new(0.4, 0.8)
					emitter.Speed = NumberRange.new(4, 8)
					emitter.Parent = primaryPart
				end

				if pieceModel:IsA("Model") then
					local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out, -1, true)
					local tween = TweenService:Create(pieceModel, tweenInfo, {CFrame = targetCFrame + Vector3.new(0, 2.5, 0)})
					tween:Play()
					table.insert(activeWinTweens, {Tween = tween, Model = pieceModel, OriginalCFrame = targetCFrame, Emitter = emitter, IsModel = true})
				elseif primaryPart and primaryPart:IsA("BasePart") then
					local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out, -1, true)
					local tween = TweenService:Create(primaryPart, tweenInfo, {CFrame = primaryPart.CFrame + Vector3.new(0, 2.5, 0)})
					tween:Play()
					table.insert(activeWinTweens, {Tween = tween, Part = primaryPart, OriginalCFrame = primaryPart.CFrame, Emitter = emitter, IsModel = false})
				end
			end
		end
	end
end

local function clearWinEffects()
	for _, data in ipairs(activeWinTweens) do
		if data.Tween then
			data.Tween:Cancel()
		end
		if data.IsModel and data.Model and data.Model.Parent then
			data.Model:PivotTo(data.OriginalCFrame)
		elseif data.Part and data.Part.Parent then
			data.Part.CFrame = data.OriginalCFrame
		end
		if data.Emitter then
			data.Emitter:Destroy()
		end
	end
	table.clear(activeWinTweens)
end

------------------------------------------------
-- ВИБІР СКЛАДНОСТІ БОТА (Виправлений список і виключення конфліктів)
------------------------------------------------

local function wireDifficultyDropdown(button, piece)
	local menu = button:FindFirstChild("DifficultyMenu")

	-- Якщо меню складності ще немає у кнопці — створюємо його автоматично з правильним списком
	if not menu then
		menu = Instance.new("Frame")
		menu.Name = "DifficultyMenu"
		menu.Size = UDim2.new(1, 0, 0, 140)
		menu.Position = UDim2.new(0, 0, 1, 5)
		menu.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
		menu.Visible = false

		local menuCorner = Instance.new("UICorner")
		menuCorner.CornerRadius = UDim.new(0, 8)
		menuCorner.Parent = menu

		local uiList = Instance.new("UIListLayout")
		uiList.SortOrder = Enum.SortOrder.LayoutOrder
		uiList.Padding = UDim.new(0, 4)
		uiList.Parent = menu

		-- ВИПРАВЛЕНИЙ СПИСОК: Easy, Medium, Hard, Impossible
		local difficulties = { "Easy", "Medium", "Hard", "Impossible" }
		for i, diffName in ipairs(difficulties) do
			local optBtn = Instance.new("TextButton")
			optBtn.Name = diffName
			optBtn.Size = UDim2.new(1, 0, 0, 30)
			optBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
			optBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			optBtn.Text = diffName
			optBtn.TextSize = 14
			optBtn.FontFace = Font.new("rbxasset://fonts.families.FredokaOne.json")
			optBtn.LayoutOrder = i
			optBtn.Parent = menu
		end

		menu.Parent = button
		table.insert(allMenus, menu)
	end

	button.MouseButton1Click:Connect(function()
		local willBeVisible = not menu.Visible
		-- Закриваємо всі інші відкриті меню на екрані
		for _, m in ipairs(allMenus) do
			m.Visible = false
		end
		menu.Visible = willBeVisible
	end)

	for _, optionButton in ipairs(menu:GetChildren()) do
		if optionButton:IsA("TextButton") then
			optionButton.MouseButton1Click:Connect(function()
				SetBotDifficulty:FireServer(piece, optionButton.Name)
				menu.Visible = false
			end)
		end
	end
end

wireDifficultyDropdown(bot1Text, "O")
wireDifficultyDropdown(bot2Text, "Rune")

------------------------------------------------
-- ОТРИМАННЯ ІНФОРМАЦІЇ ПРО БОТІВ ВІД СЕРВЕРА
------------------------------------------------

SendBotsInfo.OnClientEvent:Connect(function(bot1Name, bot1Diff, bot2Name, bot2Diff)

	if bot1Name and bot1Diff then
		local coloredBot1Name = string.format('<font color="%s">%s</font>', PieceColors.O, tostring(bot1Name))
		bot1Text.Text = string.format("%s: %s", coloredBot1Name, tostring(bot1Diff))
		bot1Text.Visible = true
	else
		bot1Text.Visible = false
		local menu1 = bot1Text:FindFirstChild("DifficultyMenu")
		if menu1 then menu1.Visible = false end
	end

	if bot2Name and bot2Diff then
		local coloredBot2Name = string.format('<font color="%s">%s</font>', PieceColors.Rune, tostring(bot2Name))
		bot2Text.Text = string.format("%s: %s", coloredBot2Name, tostring(bot2Diff))
		bot2Text.Visible = true
	else
		bot2Text.Visible = false
		local menu2 = bot2Text:FindFirstChild("DifficultyMenu")
		if menu2 then menu2.Visible = false end
	end

end)

YourPiece.OnClientEvent:Connect(function(piece)
	yourPieceText.Text = "YOU: " .. getColoredText(piece)
end)

TurnUpdate.OnClientEvent:Connect(function(piece)
	turnText.Text = "TURN: " .. getColoredText(piece)
end)

GameResult.OnClientEvent:Connect(function(piece, winLine, soundId)
	if piece == "Draw" then
		winnerText.Text = "DRAW!"
	else
		winnerText.Text = getColoredText(piece) .. " WINS!"

		pcall(function()
			playWinEffects(piece, winLine, soundId)
		end)
	end

	winnerText.Visible = true
	restartButton.Visible = true
end)

restartButton.MouseButton1Click:Connect(function()
	clearWinEffects()
	RestartGame:FireServer()

	winnerText.Visible = false
	restartButton.Visible = false
end)]]></ProtectedString>
