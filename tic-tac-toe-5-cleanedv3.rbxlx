					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Constants = require(script.Parent.Constants)

local GameState = {}

--------------------------------------------------
-- Current Match
--------------------------------------------------

GameState.Match = {

	State = Constants.MatchState.Waiting,

	Mode = Constants.GameMode.FiveInRow,

	CurrentTurn = Constants.PieceType.X,

	Winner = nil,

	TimeRemaining = 0

}

--------------------------------------------------
-- Players
--------------------------------------------------

GameState.Players = {

	X = nil,

	O = nil,

	Rune = nil

}

--------------------------------------------------
-- Board
--------------------------------------------------

GameState.Board = {}

--------------------------------------------------
-- Statistics
--------------------------------------------------

GameState.Stats = {

	MoveCount = 0,

	StartTime = 0,

	EndTime = 0

}

--------------------------------------------------
-- Public Functions
--------------------------------------------------

function GameState:Reset()

	self.Match.State = Constants.MatchState.Waiting
	self.Match.Mode = Constants.GameMode.FiveInRow
	self.Match.CurrentTurn = Constants.PieceType.X
	self.Match.Winner = nil
	self.Match.TimeRemaining = 0

	self.Players.X = nil
	self.Players.O = nil
	self.Players.Rune = nil

	self.Board = {}

	self.Stats.MoveCount = 0
	self.Stats.StartTime = 0
	self.Stats.EndTime = 0

end

return GameState]]></ProtectedString>
