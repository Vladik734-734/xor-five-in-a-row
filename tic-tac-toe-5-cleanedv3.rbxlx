						<ProtectedString name="Source"><![CDATA[local PlayerData =
	require(
		game.ReplicatedStorage.Core.PlayerData
	)


local PlayerManager={}


local Data={}



function PlayerManager:Add(player)

	Data[player.UserId]=
		PlayerData.Create(player)

end



function PlayerManager:Get(player)

	return Data[player.UserId]

end



function PlayerManager:Remove(player)

	Data[player.UserId]=nil

end



return PlayerManager]]></ProtectedString>
