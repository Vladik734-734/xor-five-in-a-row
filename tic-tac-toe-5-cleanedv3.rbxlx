					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Security = {}



local requests = {}



function Security:CheckRate(player)


	local id =
		player.UserId



	local now =
		os.clock()



	if requests[id] then


		if now - requests[id] < 0.2 then

			return false

		end


	end



	requests[id]=now


	return true

end




function Security:Clear(player)


	requests[player.UserId]=nil


end



return Security]]></ProtectedString>
