			<Item class="LocalScript" referent="RBX3600D52C444544AAB3F7A9257287316A">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Створюємо папку Remotes та RemoteEvent, якщо їх ще немає
local remotes = ReplicatedStorage:FindFirstChild("Remotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	remotes.Parent = ReplicatedStorage
end

local victoryEvent = remotes:FindFirstChild("ShowVictoryBanner")
if not victoryEvent then
	victoryEvent = Instance.new("RemoteEvent")
	victoryEvent.Name = "ShowVictoryBanner"
	victoryEvent.Parent = remotes
end

-- Функція відображення анімованого банера
local function displayVictoryBanner(winnerText)
	-- Якщо старий банер ще є, прибираємо його
	if playerGui:FindFirstChild("VictoryGui") then
		playerGui.VictoryGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "VictoryGui"
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = playerGui

	local textLabel = Instance.new("TextLabel")
	textLabel.Name = "VictoryText"
	textLabel.Size = UDim2.new(1, 0, 0, 120)
	textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	textLabel.Position = UDim2.new(0.5, 0, 0.3, 0) -- Позиція у верхній частині екрана
	textLabel.BackgroundTransparency = 1
	textLabel.Text = winnerText or "ПЕРЕМОГА!"
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 20 -- Стартовий розмір для анімації появи
	textLabel.Font = Enum.Font.FredokaOne -- Наш улюблений шрифт
	textLabel.TextTransparency = 1
	textLabel.TextStrokeTransparency = 1
	textLabel.TextStrokeColor3 = Color3.fromRGB(180, 80, 0) -- Обводка для об'єму
	textLabel.Parent = screenGui

	-- Яскраво-жовтий градієнт із переливом
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 100)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 200, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 140, 0))
	})
	gradient.Parent = textLabel

	-- Анімація появи (пружина)
	local showTween = TweenService:Create(textLabel, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		TextSize = 65,
		TextTransparency = 0,
		TextStrokeTransparency = 0.2
	})
	showTween:Play()

	-- Динамічний перелив кольору під час показу
	local active = true
	task.spawn(function()
		while active and gradient and gradient.Parent do
			local t = tick() * 3
			gradient.Offset = Vector2.new(math.sin(t) * 0.3, 0)
			task.wait(0.05)
		end
	end)

	-- Тримаємо на екрані 4 секунди, після чого плавно ховаємо і видаляємо
	task.delay(4, function()
		active = false
		if textLabel and textLabel.Parent then
			local hideTween = TweenService:Create(textLabel, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				TextSize = 40,
				TextTransparency = 1,
				TextStrokeTransparency = 1
			})
			hideTween:Play()
			hideTween.Completed:Wait()
			screenGui:Destroy()
		end
	end)
end

-- Слухаємо команду з сервера
victoryEvent.OnClientEvent:Connect(function(winnerText)
	displayVictoryBanner(winnerText)
end)]]></ProtectedString>
