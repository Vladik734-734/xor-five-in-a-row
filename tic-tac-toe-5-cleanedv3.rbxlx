				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local StateManager = {}

local state = "Lobby"

local callbacks = {}


function StateManager:Get()

	return state

end


function StateManager:Set(newState)

	if state == newState then
		return
	end

	local old = state

	state = newState


	print(
		"[STATE]",
		old,
		"->",
		newState
	)


	for _,callback in callbacks do

		task.spawn(
			callback,
			newState,
			old
		)

	end

end



function StateManager:Subscribe(callback)

	table.insert(
		callbacks,
		callback
	)

end



function StateManager:Is(check)

	return state == check

end


return StateManager]]></ProtectedString>
