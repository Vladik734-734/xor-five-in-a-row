						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Elo =
	require(
		script.Parent.EloCalculator
	)


local RankedManager = {}



function RankedManager:CalculateWinner(
	player,
	opponent
)


	local change =
		Elo.Calculate(
			player.Rating,
			opponent.Rating,
			1
		)



	player.Rating += change


	return change

end





function RankedManager:CalculateLose(
	player,
	opponent
)


	local change =
		Elo.Calculate(
			player.Rating,
			opponent.Rating,
			0
		)



	player.Rating += change


	return change

end



return RankedManager]]></ProtectedString>
