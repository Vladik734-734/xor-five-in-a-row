				<Properties>
					<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local RestartGame = Remotes:WaitForChild("RestartGame")
local GameResult = Remotes:WaitForChild("GameResult")
local TurnUpdate = Remotes:WaitForChild("TurnUpdate")
local YourPiece = Remotes:WaitForChild("YourPiece")
local SendBotsInfo = Remotes:WaitForChild("SendBotsInfo")
local SetBotDifficulty = Remotes:WaitForChild("SetBotDifficulty")
local SetWinSound = Remotes:WaitForChild("SetWinSound")

local gui = script.Parent

local winnerText = gui:WaitForChild("WinnerText")
local restartButton = gui:WaitForChild("RestartButton")
local yourPieceText = gui:WaitForChild("YourPieceText")

local turnPanel = gui:WaitForChild("TurnPanel")
local turnText = turnPanel:WaitForChild("TurnText")

-- Текстові кнопки для ботів у TurnPanel
local bot1Text = turnPanel:WaitForChild("Bot1Text")
local bot2Text = turnPanel:WaitForChild("Bot2Text")

-- Увімкнення RichText для кольорового тексту
winnerText.RichText = true
yourPieceText.RichText = true
turnText.RichText = true
bot1Text.RichText = true
bot2Text.RichText = true

-- Написи ботів приховані, поки бот справді не зайняв слот
bot1Text.Visible = false
bot2Text.Visible = false

-- Зберігаємо посилання на всі випадаючі меню для керування ними
local allMenus = {}

-- Назви фігур
local Names = {
	X = "X",
	O = "O",
	Rune = "R"
}

-- Кольори фігур та ботів: X = Зелений, O = Червоний, Rune = Синій
local PieceColors = {
	X = "#00FF00",
	O = "#FF0000",
	Rune = "#0000FF"
}

-- Допоміжна функція для створення кольорового тексту
local function getColoredText(piece)
	local name = Names[piece] or tostring(piece)
	local hexColor = PieceColors[piece] or "#FFFFFF"
	return string.format('<font color="%s">%s</font>', hexColor, name)
end

winnerText.Visible = false
restartButton.Visible = false

------------------------------------------------
-- СТИЛІЗАЦІЯ КНОПОК БОТІВ (Видимі межі та фон)
------------------------------------------------

local function styleBotButton(btn)
	btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.AutoButtonColor = true

	-- Округлення кутів
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	-- Чітка рамка/межі кнопки
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(90, 90, 110)
	stroke.Thickness = 1.5
	stroke.Parent = btn

	-- Внутрішні відступи
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = btn
end

styleBotButton(bot1Text)
styleBotButton(bot2Text)

