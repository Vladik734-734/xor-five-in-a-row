				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local ReplicatedStorage =
	game:GetService(
		"ReplicatedStorage"
	)


local Remotes =
	ReplicatedStorage.Remotes



local RemoteManager = {}



function RemoteManager:Get(folder,name)


	local category =
		Remotes:FindFirstChild(folder)


	if not category then

		warn(
			"Remote folder missing:",
			folder
		)

		return

	end



	local remote =
		category:FindFirstChild(name)



	if not remote then

		warn(
			"Remote missing:",
			name
		)

		return

	end



	return remote

end



return RemoteManager]]></ProtectedString>
