				<Item class="ModuleScript" referent="RBX91AC5BB4FCE04D31A2CE236A0396190B">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local PieceTypes = {}

PieceTypes.X = {
	Id = 1,
	Name = "X",
	Color = Color3.fromRGB(0, 255, 120)
}

PieceTypes.O = {
	Id = 2,
	Name = "O",
	Color = Color3.fromRGB(255, 70, 70)
}

PieceTypes.Rune = {
	Id = 3,
	Name = "Rune",
	Color = Color3.fromRGB(0, 170, 255)
}

function PieceTypes:GetById(id)

	if id == 1 then
		return self.X
	end

	if id == 2 then
		return self.O
	end

	if id == 3 then
		return self.Rune
	end

	return nil

end

return PieceTypes]]></ProtectedString>
