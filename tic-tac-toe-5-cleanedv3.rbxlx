			<Item class="ModuleScript" referent="RBX11EA419FFC574DE6BE092E9D86674BE0">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage > Core > PieceManager  (замінити весь Source)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Constants = require(ReplicatedStorage.Core.Constants)
local PieceFactory = require(
	ReplicatedStorage.Modules.Pieces.PieceFactory
)

local PieceManager = {}

local PieceNameToId = {
	X = 1,
	O = 2,
	Rune = 3
}

function PieceManager.CreatePiece(pieceType, position)

	local pieceId = PieceNameToId[pieceType]

	if not pieceId then
		warn("Unknown piece type:", pieceType)
		return nil
	end

	local model = PieceFactory.Create(pieceId)

	if not model then
		warn("PieceFactory failed to create piece:", pieceType)
		return nil
	end

	-- 1. Звук постановки фігути
	local soundId = (Constants.SOUNDS and Constants.SOUNDS.PLACE_PIECE) or "rbxassetid://4590657391"
	local placeSound = Instance.new("Sound")
	placeSound.SoundId = soundId
	placeSound.Volume = 0.6
	placeSound.Parent = SoundService
	placeSound:Play()
	placeSound.Ended:Connect(function()
		placeSound:Destroy()
	end)

	-- 2. Розміщення у папці
	model.Parent = workspace.Board.Pieces

	-- Цільова позиція
	local targetPosition = position + Vector3.new(0, 0.5, 0)

	-- Ставимо спочатку на місце (щоб отримати правильний CFrame)
	if model:IsA("Model") then
		model:MoveTo(targetPosition)

		-- Плавна анімація появи всієї моделі знизу вгору без розриву деталей
		local startCFrame = model:GetPivot() - Vector3.new(0, 1.5, 0)
		local finalCFrame = model:GetPivot()

		model:PivotTo(startCFrame)

		-- Використовуємо TweenService через ValueBase для плавної інтерполяції всього Pivoting
		local val = Instance.new("CFrameValue")
		val.Value = startCFrame

		val.Changed:Connect(function(newCFrame)
			if model and model.Parent then
				model:PivotTo(newCFrame)
			end
		end)

		local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		local tween = TweenService:Create(val, tweenInfo, {Value = finalCFrame})
		tween:Play()

		tween.Completed:Connect(function()
			val:Destroy()
		end)
	else
		-- Якщо це звичайний Part
		model.Position = targetPosition
		local targetSize = model.Size
		model.Size = Vector3.new(0, 0, 0)

		local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)
		local tween = TweenService:Create(model, tweenInfo, {Size = targetSize})
		tween:Play()
	end

	return model

end

return PieceManager]]></ProtectedString>
					<string name="ScriptGuid">{4BF729C8-0759-4182-A036-C3E622E0D714}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
