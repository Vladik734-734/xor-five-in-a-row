						<string name="ScriptGuid">{4BCD98CB-972B-4AE7-A328-1DB5F7F007BF}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">BotDifficulty</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">53b90d59c6f66e400a6886d000001574</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX12F6E476A77A4AD4A45413E1473BDFDB">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local BotDifficulty = require(script.Parent.BotDifficulty)
local EasyBot = require(script.Parent.EasyBot)
local MediumBot = require(script.Parent.MediumBot)
local HardBot = require(script.Parent.HardBot)
local ImpossibleBot = require(script.Parent.ImpossibleBot)

local BotAI = {}

function BotAI:GetMove(difficulty, boardState, boardSize)
	if difficulty == BotDifficulty.Easy then
		return EasyBot:GetMove(boardState, boardSize)
	elseif difficulty == BotDifficulty.Medium then
		return MediumBot:GetMove(boardState, boardSize)
	elseif difficulty == BotDifficulty.Hard then
		return HardBot:GetMove(boardState, boardSize)
	elseif difficulty == BotDifficulty.Impossible then
		return ImpossibleBot:GetMove(boardState, boardSize)
	else
		return ImpossibleBot:GetMove(boardState, boardSize)
	end
end

return BotAI]]></ProtectedString>
						<string name="ScriptGuid">{B8530D66-027A-4272-81ED-48A09465E186}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">BotAI</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">53b90d59c6f66e400a6886d000001577</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX471C5386696247A3B8FD0FB8FC2706B0">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local BotAI = require(script.Parent.BotAI)
local BotDifficulty = require(script.Parent.BotDifficulty)

local BotManager = {}

function BotManager:Create(name, difficulty, pieceType)
	return {
		Name = name,
		IsBot = true,
		Difficulty = difficulty,
		PieceType = pieceType
	}
end

function BotManager:CreateZeroBot(name, difficulty)
	return self:Create(name or "ZeroBot", difficulty or BotDifficulty.Impossible, "O")
end

function BotManager:CreateRuneBot(name, difficulty)
	return self:Create(name or "RuneBot", difficulty or BotDifficulty.Impossible, "Rune")
end

function BotManager:GetMove(bot, boardState, boardSize)
	return BotAI:GetMove(bot.Difficulty, boardState, boardSize)
end

return BotManager]]></ProtectedString>
						<string name="ScriptGuid">{85442262-DD88-4F9F-BE5E-88AE6DB928DF}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">BotManager</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">53b90d59c6f66e400a6886d00000157a</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX540D3BFD72CD0105B9AC572C4043E3FC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage > Modules > Bots > BotAvatar
--
-- Спавнить фігурку бота з підвищеною швидкістю (20), серійними стрибками,
-- обертаннями, хаотичним патрулюванням балкона та можливістю підійти до клітинки 
-- і стрибати над нею при довгому очікуванні ходу гравця.

local BotAvatar = {}

local MOVE_TIMEOUT = 8      -- макс. час очікування на один відрізок шляху
local PAUSE_AT_POINT = 1    -- пауза на контрольній точці

------------------------------------------------
-- ПОБУДОВА ПРОСТОЇ ФІГУРКИ
------------------------------------------------

local function weld(root, part, offsetCFrame)
	part.CFrame = root.CFrame * offsetCFrame
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = part
	w.Parent = part
end

local function buildRig(name, color)
	local model = Instance.new("Model")
	model.Name = name

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model

	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2, 2, 1)
	torso.Color = color
	torso.Material = Enum.Material.SmoothPlastic
	torso.CanCollide = false
	torso.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(1.4, 1.4, 1.4)
	head.Color = color
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Parent = model

	local function makeLimb(limbName, size)
		local p = Instance.new("Part")
		p.Name = limbName
		p.Size = size
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.Parent = model
		return p
	end

	local leftArm = makeLimb("Left Arm", Vector3.new(1, 2, 1))
	local rightArm = makeLimb("Right Arm", Vector3.new(1, 2, 1))
	local leftLeg = makeLimb("Left Leg", Vector3.new(1, 2, 1))
	local rightLeg = makeLimb("Right Leg", Vector3.new(1, 2, 1))

	weld(root, torso, CFrame.new(0, 0, 0))
	weld(root, head, CFrame.new(0, 1.7, 0))
	weld(root, leftArm, CFrame.new(-1.5, 0, 0))
	weld(root, rightArm, CFrame.new(1.5, 0, 0))
	weld(root, leftLeg, CFrame.new(-0.5, -2, 0))
	weld(root, rightLeg, CFrame.new(0.5, -2, 0))

	local humanoid = Instance.new("Humanoid")
	humanoid.WalkSpeed = 20 -- Збільшена швидкість до 20
	humanoid.JumpPower = 50
	humanoid.Parent = model

	local nameTag = Instance.new("BillboardGui")
	nameTag.Name = "NameTag"
	nameTag.Size = UDim2.new(4, 0, 1, 0)
	nameTag.StudsOffset = Vector3.new(0, 2.5, 0)
	nameTag.AlwaysOnTop = true
	nameTag.Adornee = head
	nameTag.Parent = head

	local tagLabel = Instance.new("TextLabel")
	tagLabel.BackgroundTransparency = 1
	tagLabel.Size = UDim2.new(1, 0, 1, 0)
	tagLabel.Text = name
	tagLabel.TextColor3 = color
	tagLabel.TextScaled = true
	tagLabel.Font = Enum.Font.GothamBold
	tagLabel.TextStrokeTransparency = 0
	tagLabel.Parent = nameTag

	model.PrimaryPart = root

	return model, humanoid
end

------------------------------------------------
-- ДОПОМІЖНІ ФУНКЦІЇ ДЛЯ РУХУ
------------------------------------------------

local function modelValid(model)
	return model and model.Parent and model.PrimaryPart
end

local function moveToWithTimeout(model, humanoid, rootPart, target, timeout)
	local finished = false

	local connection
	connection = humanoid.MoveToFinished:Connect(function(reached)
		finished = true
	end)

	humanoid:MoveTo(target)

	local elapsed = 0
	local jumpSeriesCount = 0

	while not finished and elapsed < timeout do
		task.wait(0.15)
		elapsed += 0.15

		if not modelValid(model) then break end
		-- Якщо увімкнено спец-режим (очікування ходу гравця), перериваємо звичайний шлях
		if model:GetAttribute("IsDoingSpecialAction") then
			connection:Disconnect()
			return
		end

		-- 1. Випадкові обертання навколо своєї осі
		if math.random(1, 12) == 1 then
			local randomAngle = math.rad(math.random(-90, 90))
			rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, randomAngle, 0)
		end

		-- 2. Серійні стрибки (2-3 стрибки підряд)
		if jumpSeriesCount > 0 then
			humanoid.Jump = true
			jumpSeriesCount -= 1
		elseif math.random(1, 20) == 1 then
			jumpSeriesCount = math.random(2, 3)
		end
	end

	connection:Disconnect()
end

------------------------------------------------
-- ПУБЛІЧНЕ API
------------------------------------------------

-- Спавн бота та запуск патрулювання
function BotAvatar.Spawn(name, color, waypoints, startIndex)
	if not waypoints or #waypoints == 0 then
		warn("BotAvatar.Spawn: no waypoints given for", name)
		return nil
	end

	local model, humanoid = buildRig(name, color)
	model.Parent = workspace
	local rootPart = model.PrimaryPart

	local startPos = waypoints[startIndex or 1]
	model:PivotTo(CFrame.new(startPos))

	task.spawn(function()
		local index = startIndex or 1

		while model.Parent do
			-- Якщо бот виконує спец-дію (стрибає на клітинці), чекаємо завершення спец-дії
			while model:GetAttribute("IsDoingSpecialAction") do
				task.wait(0.5)
				if not model.Parent then return end
			end

			index = (index % #waypoints) + 1
			local target = waypoints[index]

			moveToWithTimeout(model, humanoid, rootPart, target, MOVE_TIMEOUT)

			if not model.Parent then
				break
			end

			-- Пауза на точці з елементом хаосу (може покрутитись)
			if math.random(1, 3) == 1 and rootPart and not model:GetAttribute("IsDoingSpecialAction") then
				local spinDuration = math.random(3, 6)
				for _ = 1, spinDuration do
					if not modelValid(model) or model:GetAttribute("IsDoingSpecialAction") then break end
					rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(45), 0)
					task.wait(0.1)
				end
			end

			task.wait(PAUSE_AT_POINT)
		end
	end)

	return model
end

-- Бот йде на клітинку з останнім ходом і починає гарантовано стрибати (зміною висоти)
function BotAvatar.GoToCellAndJump(model, cellPosition)
	if not modelValid(model) then return end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local rootPart = model.PrimaryPart
	if not humanoid or not rootPart then return end

	model:SetAttribute("IsDoingSpecialAction", true)

	task.spawn(function()
		local targetPos = Vector3.new(cellPosition.X, cellPosition.Y + 2, cellPosition.Z)
		humanoid:MoveTo(targetPos)

		local elapsed = 0
		while elapsed < 5 do
			if not modelValid(model) or not model:GetAttribute("IsDoingSpecialAction") then return end
			task.wait(0.2)
			elapsed += 0.2
		end

		-- Надійний анімаційний стрибок через зміну висоти CFrame (працює для будь-яких блоків)
		while modelValid(model) and model:GetAttribute("IsDoingSpecialAction") do
			local currentCF = model:GetPivot()
			local pos = currentCF.Position

			-- Підстрибуємо вгору на 3 студи
			model:PivotTo(currentCF + Vector3.new(0, 3, 0))
			task.wait(0.2)

			if not modelValid(model) or not model:GetAttribute("IsDoingSpecialAction") then break end

			-- Опускаємося назад
			model:PivotTo(currentCF)
			task.wait(0.8)
		end
	end)
end

return BotAvatar]]></ProtectedString>
						<string name="ScriptGuid">{D00DDF5B-181E-423E-96BE-4E4EA6CB3609}</string>
