						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local AchievementData =
	require(script.Parent.AchievementData)



local Manager={}



function Manager:Check(player,data)


	local unlocked={}


	if data.Wins >= 1 then

		table.insert(
			unlocked,
			AchievementData.FirstWin
		)

	end



	if data.Wins >=10 then

		table.insert(
			unlocked,
			AchievementData.TenWins
		)

	end



	if data.Rating >=2000 then

		table.insert(
			unlocked,
			AchievementData.Master
		)

	end



	return unlocked

end



return Manager]]></ProtectedString>
