			<Properties>
				<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService(
	"ReplicatedStorage"
)


local BoardConfig = require(
	ReplicatedStorage.Config.BoardConfig
)



local BOARD_SIZE = BoardConfig.SIZE
local CELL_SIZE = BoardConfig.CELL_SIZE



local boardFolder = workspace:WaitForChild(
	"Board"
)



------------------------------------------------
-- CLEAN OLD BOARD
------------------------------------------------


for _,v in pairs(boardFolder:GetChildren()) do

	v:Destroy()

end



local Cells = Instance.new("Folder")
Cells.Name = "Cells"
Cells.Parent = boardFolder


local Lines = Instance.new("Folder")
Lines.Name = "Lines"
Lines.Parent = boardFolder


local Pieces = Instance.new("Folder")
Pieces.Name = "Pieces"
Pieces.Parent = boardFolder



------------------------------------------------
-- CREATE BOARD CELLS
------------------------------------------------


for x = 1, BOARD_SIZE do

	for z = 1, BOARD_SIZE do

		local cell = Instance.new("Part")

		cell.Name = 
			"Cell_"..x.."_"..z


		cell.Size = Vector3.new(
			CELL_SIZE,
			0.5,
			CELL_SIZE
		)


		cell.Anchored = true


		cell.Position = Vector3.new(
			(x - BOARD_SIZE/2 - 0.5) * CELL_SIZE,
			0,
			(z - BOARD_SIZE/2 - 0.5) * CELL_SIZE
		)


		cell.Color = BoardConfig.COLORS.Board


		cell.Material = Enum.Material.SmoothPlastic


		cell.Parent = Cells

	end
end



------------------------------------------------
-- CREATE GRID LINES
------------------------------------------------


local boardLength =
	BOARD_SIZE * CELL_SIZE



for i = 0, BOARD_SIZE do


	-- vertical lines

	local lineX = Instance.new("Part")

	lineX.Name = "LineX_"..i


	lineX.Size = Vector3.new(
		0.05,
		0.1,
		boardLength
	)


	lineX.Anchored = true


	lineX.Position = Vector3.new(
		(i - BOARD_SIZE/2) * CELL_SIZE,
		0.3,
		0
	)


	lineX.Color =
		BoardConfig.COLORS.Line


	lineX.Parent = Lines



	-- horizontal lines


	local lineZ = Instance.new("Part")

	lineZ.Name = "LineZ_"..i


	lineZ.Size = Vector3.new(
		boardLength,
		0.1,
		0.05
	)


	lineZ.Anchored = true


	lineZ.Position = Vector3.new(
		0,
		0.3,
		(i - BOARD_SIZE/2) * CELL_SIZE
	)


	lineZ.Color =
		BoardConfig.COLORS.Line


	lineZ.Parent = Lines



end



------------------------------------------------
-- ENVIRONMENT (Ground + Solid Balconies + Railings with cutouts + 4 Ramps + Hive Walls)
------------------------------------------------

if not workspace:FindFirstChild("Environment") then

	local envHalf = (BOARD_SIZE * CELL_SIZE) / 2 -- 40 для поля 20x20

	local WALKWAY_WIDTH = 8
	local WALKWAY_HEIGHT = 6
	local WALKWAY_THICKNESS = 1
	local RAILING_HEIGHT = 3
	local RAILING_THICKNESS = 0.4
	local RAMP_RUN = 14
	local GROUND_SIZE = 400

	local envOuter = envHalf + WALKWAY_WIDTH

	local Environment = Instance.new("Folder")
	Environment.Name = "Environment"
	Environment.Parent = workspace


	local function newPart(name, size, position, material, color, parent)

		local part = Instance.new("Part")

		part.Name = name
		part.Anchored = true
		part.Size = size
		part.Position = position
		part.Material = material
		part.Color = color
		part.Parent = parent

		return part

	end


	------------------------------------------------
	-- GROUND
	------------------------------------------------

	newPart(
		"Ground",
		Vector3.new(GROUND_SIZE, 2, GROUND_SIZE),
		Vector3.new(0, -1.5, 0),
		Enum.Material.Grass,
		Color3.fromRGB(85, 170, 90),
		Environment
	)


	------------------------------------------------
	-- BALCONY RING (Суцільна підлога балконів з усіх 4 сторін, без жодних дірок)
	------------------------------------------------

	local walkwayY = WALKWAY_HEIGHT - WALKWAY_THICKNESS / 2
	local barMaterial = Enum.Material.WoodPlanks
	local barColor = Color3.fromRGB(120, 85, 60)

	newPart("Walkway_North", Vector3.new(envOuter * 2, WALKWAY_THICKNESS, WALKWAY_WIDTH),
		Vector3.new(0, walkwayY, envHalf + WALKWAY_WIDTH / 2), barMaterial, barColor, Environment)

	newPart("Walkway_South", Vector3.new(envOuter * 2, WALKWAY_THICKNESS, WALKWAY_WIDTH),
		Vector3.new(0, walkwayY, -(envHalf + WALKWAY_WIDTH / 2)), barMaterial, barColor, Environment)

	newPart("Walkway_East", Vector3.new(WALKWAY_WIDTH, WALKWAY_THICKNESS, envHalf * 2),
		Vector3.new(envHalf + WALKWAY_WIDTH / 2, walkwayY, 0), barMaterial, barColor, Environment)

	newPart("Walkway_West", Vector3.new(WALKWAY_WIDTH, WALKWAY_THICKNESS, envHalf * 2),
		Vector3.new(-(envHalf + WALKWAY_WIDTH / 2), walkwayY, 0), barMaterial, barColor, Environment)


	------------------------------------------------
	-- RAILINGS (Заборчики із прорізами для проходу навпроти кожної рампи)
	------------------------------------------------

	local railingY = WALKWAY_HEIGHT + RAILING_HEIGHT / 2
	local railMaterial = Enum.Material.Wood
	local railColor = Color3.fromRGB(70, 50, 35)

	local railTotalWidth = envOuter * 2
	local railSegmentLength = (railTotalWidth - WALKWAY_WIDTH) / 2
	local railOffset = railTotalWidth / 2 - railSegmentLength / 2

	-- Північний заборчик (з розривом по центру)
	newPart("Railing_North_Left", Vector3.new(railSegmentLength, RAILING_HEIGHT, RAILING_THICKNESS),
		Vector3.new(-railOffset, railingY, envOuter), railMaterial, railColor, Environment)
	newPart("Railing_North_Right", Vector3.new(railSegmentLength, RAILING_HEIGHT, RAILING_THICKNESS),
		Vector3.new(railOffset, railingY, envOuter), railMaterial, railColor, Environment)

	-- Південний заборчик (з розривом по центру)
	newPart("Railing_South_Left", Vector3.new(railSegmentLength, RAILING_HEIGHT, RAILING_THICKNESS),
		Vector3.new(-railOffset, railingY, -envOuter), railMaterial, railColor, Environment)
	newPart("Railing_South_Right", Vector3.new(railSegmentLength, RAILING_HEIGHT, RAILING_THICKNESS),
		Vector3.new(railOffset, railingY, -envOuter), railMaterial, railColor, Environment)

	-- Східний заборчик (з розривом по центру)
	newPart("Railing_East_North", Vector3.new(RAILING_THICKNESS, RAILING_HEIGHT, railSegmentLength),
		Vector3.new(envOuter, railingY, railOffset), railMaterial, railColor, Environment)
	newPart("Railing_East_South", Vector3.new(RAILING_THICKNESS, RAILING_HEIGHT, railSegmentLength),
		Vector3.new(envOuter, railingY, -railOffset), railMaterial, railColor, Environment)

	-- Західний заборчик (з розривом по центру)
	newPart("Railing_West_North", Vector3.new(RAILING_THICKNESS, RAILING_HEIGHT, railSegmentLength),
		Vector3.new(-envOuter, railingY, railOffset), railMaterial, railColor, Environment)
	newPart("Railing_West_South", Vector3.new(RAILING_THICKNESS, RAILING_HEIGHT, railSegmentLength),
		Vector3.new(-envOuter, railingY, -railOffset), railMaterial, railColor, Environment)


	------------------------------------------------
	-- RAMPS (Земля -> Балкон, з усіх 4 сторін)
	------------------------------------------------

	local function createRamp(name, bottomPos, topPos)
		local rampLength = (topPos - bottomPos).Magnitude
		local rampMid = (bottomPos + topPos) / 2

		local ramp = Instance.new("Part")
		ramp.Name = name
		ramp.Anchored = true
		ramp.Size = Vector3.new(WALKWAY_WIDTH, WALKWAY_THICKNESS, rampLength)
		ramp.CFrame = CFrame.lookAt(rampMid, topPos)
		ramp.Material = barMaterial
		ramp.Color = barColor
		ramp.Parent = Environment
	end

	-- Північна рампа
	createRamp("Ramp_North", 
		Vector3.new(0, WALKWAY_THICKNESS / 2, envHalf + WALKWAY_WIDTH + RAMP_RUN),
		Vector3.new(0, WALKWAY_HEIGHT - WALKWAY_THICKNESS / 2, envHalf + WALKWAY_WIDTH)
	)

	-- Південна рампа
	createRamp("Ramp_South", 
		Vector3.new(0, WALKWAY_THICKNESS / 2, -(envHalf + WALKWAY_WIDTH + RAMP_RUN)),
		Vector3.new(0, WALKWAY_HEIGHT - WALKWAY_THICKNESS / 2, -(envHalf + WALKWAY_WIDTH))
	)

	-- Східна рампа
	createRamp("Ramp_East", 
		Vector3.new(envHalf + WALKWAY_WIDTH + RAMP_RUN, WALKWAY_THICKNESS / 2, 0),
		Vector3.new(envHalf + WALKWAY_WIDTH, WALKWAY_HEIGHT - WALKWAY_THICKNESS / 2, 0)
	)

	-- Західна рампа
	createRamp("Ramp_West", 
		Vector3.new(-(envHalf + WALKWAY_WIDTH + RAMP_RUN), WALKWAY_THICKNESS / 2, 0),
		Vector3.new(-(envHalf + WALKWAY_WIDTH), WALKWAY_HEIGHT - WALKWAY_THICKNESS / 2, 0)
	)


	------------------------------------------------
	-- TRANSPARENT HIVE CUBE (Зелена прозора кімната-куб з кришкою)
	------------------------------------------------

	local wallHeight = 62 -- Висота тепер рівна 62 (утворює ідеальний куб 124x124x124)
	local wallThickness = 1.5
	local halfPlatform = envHalf + WALKWAY_WIDTH + RAMP_RUN -- 62 студи від центру

	local wallConfigs = {
		{name = "HiveWall_North", size = Vector3.new(halfPlatform * 2, wallHeight, wallThickness), pos = Vector3.new(0, wallHeight / 2, halfPlatform)},
		{name = "HiveWall_South", size = Vector3.new(halfPlatform * 2, wallHeight, wallThickness), pos = Vector3.new(0, wallHeight / 2, -halfPlatform)},
		{name = "HiveWall_East",  size = Vector3.new(wallThickness, wallHeight, halfPlatform * 2), pos = Vector3.new(halfPlatform, wallHeight / 2, 0)},
		{name = "HiveWall_West",  size = Vector3.new(wallThickness, wallHeight, halfPlatform * 2), pos = Vector3.new(-halfPlatform, wallHeight / 2, 0)},
	}

	-- Створюємо стіни куба
	for _, cfg in ipairs(wallConfigs) do
		local wall = Instance.new("Part")
		wall.Name = cfg.name
		wall.Size = cfg.size
		wall.Position = cfg.pos
		wall.Anchored = true
		wall.Transparency = 0.8                      -- Яскравість стін
		wall.Color = Color3.fromRGB(255, 255, 255) -- Колір стін
		wall.Material = Enum.Material.Glass
		wall.CanCollide = false
		wall.CanQuery = true
		wall.Parent = Environment
	end

	-- Створюємо кришку (стелю) куба
	local roof = Instance.new("Part")
	roof.Name = "HiveRoof"
	-- Розмір кришки відповідає площі квадрата основи (124 на 124)
	roof.Size = Vector3.new(halfPlatform * 2, wallThickness, halfPlatform * 2)
	-- Розміщуємо точно зверху стін на висоті 62
	roof.Position = Vector3.new(0, wallHeight, 0)
	roof.Anchored = true
	roof.Transparency = 0.99                   -- Яскравість стелі
	roof.Color = Color3.fromRGB(255, 255, 255) -- Колір стелі
	roof.Material = Enum.Material.Glass
	roof.CanCollide = false
	roof.CanQuery = true
	roof.Parent = Environment


	------------------------------------------------
	-- PATROL GEOMETRY (Для ботів-аватарів)
	------------------------------------------------

	Environment:SetAttribute("EnvHalf", envHalf)
	Environment:SetAttribute("WalkwayWidth", WALKWAY_WIDTH)
	Environment:SetAttribute("WalkwayY", walkwayY + WALKWAY_THICKNESS / 2 + 3)

	print("ENVIRONMENT (solid balconies, 4 rail cutouts, 4 ramps, hive walls) GENERATED")

end



print(
	"BOARD GENERATED SUCCESSFULLY"
)

------------------------------------------------
-- BOARD READY SIGNAL
------------------------------------------------

local ReplicatedStorage =
	game:GetService(
		"ReplicatedStorage"
	)


local BoardReady =
	ReplicatedStorage
	.Remotes
	.BoardReady



BoardReady:FireAllClients()



print(
	"BOARD READY SENT"
)]]></ProtectedString>
