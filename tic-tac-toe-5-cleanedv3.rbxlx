						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- ReplicatedStorage > Modules > Bots > HardBot

local HardBot = {}

local DIRECTIONS = {
	{x = 1, y = 0},
	{x = 0, y = 1},
	{x = 1, y = 1},
	{x = 1, y = -1}
}

local SCORE = {
	WIN = 500000,
	BLOCK_WIN = 300000,
	OPEN_THREE = 5000,
	BLOCK_THREE = 4000,
	CENTER = 10
}

local function CloneBoard(boardState, size)
	local board = {}
	for x = 1, size do
		board[x] = {}
		for y = 1, size do
			board[x][y] = boardState.GetPiece(x, y)
		end
	end
	return board
end

local function Get(board, x, y)
	if board[x] then return board[x][y] end
	return nil
end

local function Set(board, x, y, piece)
	if board[x] then board[x][y] = piece end
end

local function Inside(size, x, y)
	return x >= 1 and x <= size and y >= 1 and y <= size
end

local function AnalyzeLine(board, size, x, y, dx, dy, piece)
	local count = 1
	local openEnds = 0

	local nx, ny = x + dx, y + dy
	while Inside(size, nx, ny) and Get(board, nx, ny) == piece do
		count += 1
		nx += dx
		ny += dy
	end
	if Inside(size, nx, ny) and Get(board, nx, ny) == nil then openEnds += 1 end

	nx, ny = x - dx, y - dy
	while Inside(size, nx, ny) and Get(board, nx, ny) == piece do
		count += 1
		nx -= dx
		ny -= dy
	end
	if Inside(size, nx, ny) and Get(board, nx, ny) == nil then openEnds += 1 end

	return count, openEnds
end

local function GenerateMoves(board, size)
	local moves = {}
	for x = 1, size do
		for y = 1, size do
			if Get(board, x, y) == nil then
				local near = false
				for nx = math.max(1, x - 2), math.min(size, x + 2) do
					for ny = math.max(1, y - 2), math.min(size, y + 2) do
						if Get(board, nx, ny) ~= nil then near = true; break end
					end
					if near then break end
				end
				if near then table.insert(moves, {X = x, Y = y}) end
			end
		end
	end
	if #moves == 0 then
		local center = math.ceil(size / 2)
		table.insert(moves, {X = center, Y = center})
	end
	return moves
end

local function GetPlayers(board, size)
	local players = {}
	for x = 1, size do
		for y = 1, size do
			local p = Get(board, x, y)
			if p ~= nil then players[p] = true end
		end
	end
	return players
end

function HardBot:GetMove(boardState, size, winLength)
	local board = CloneBoard(boardState, size)
	winLength = winLength or 5
	local myPiece = "O"
	if boardState.GetCurrentPiece then myPiece = boardState.GetCurrentPiece() end

	local moves = GenerateMoves(board, size)
	if #moves == 0 then return nil end

	local players = GetPlayers(board, size)
	local opponents = {}
	for p, _ in pairs(players) do
		if p ~= myPiece then table.insert(opponents, p) end
	end

	local scoredMoves = {}
	local center = math.ceil(size / 2)

	for _, move in ipairs(moves) do
		local moveScore = 0

		-- Центрування
		local dist = math.abs(center - move.X) + math.abs(center - move.Y)
		moveScore += (size - dist) * SCORE.CENTER

		-- Атака
		Set(board, move.X, move.Y, myPiece)
		for _, dir in ipairs(DIRECTIONS) do
			local count, open = AnalyzeLine(board, size, move.X, move.Y, dir.x, dir.y, myPiece)
			if count >= winLength then
				moveScore += SCORE.WIN
			elseif count >= winLength - 1 and open >= 1 then
				moveScore += 50000
			elseif count >= winLength - 2 and open >= 2 then
				moveScore += SCORE.OPEN_THREE
			end
		end
		Set(board, move.X, move.Y, nil)

		-- Захист
		for _, opp in ipairs(opponents) do
			Set(board, move.X, move.Y, opp)
			for _, dir in ipairs(DIRECTIONS) do
				local count, open = AnalyzeLine(board, size, move.X, move.Y, dir.x, dir.y, opp)
				if count >= winLength then
					moveScore += SCORE.BLOCK_WIN
				elseif count >= winLength - 1 and open >= 1 then
					moveScore += 40000
				elseif count >= winLength - 2 and open >= 2 then
					moveScore += SCORE.BLOCK_THREE
				end
			end
			Set(board, move.X, move.Y, nil)
		end

		table.insert(scoredMoves, {Move = move, Score = moveScore})
	end

	-- Сортуємо ходи за спаданням очок
	table.sort(scoredMoves, function(a, b)
		return a.Score > b.Score
	end)

	-- Для Hard додаємо трохи непередбачуваності: з 20% шансом він може обрати 2-й або 3-й найкращий хід, а не завжди ідеальний
	local topIndex = 1
	if #scoredMoves > 2 and math.random() < 0.2 then
		topIndex = math.random(1, 3)
	end

	return scoredMoves[topIndex].Move or scoredMoves[1].Move
end

return HardBot]]></ProtectedString>
						<string name="ScriptGuid">{466EE5FA-057C-42E9-AB05-98A5782AD1A5}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">HardBot</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">53b90d59c6f66e400a6886d0000012a9</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX13D283824DDB4BC5888CB522116489A9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local ImpossibleBot = {}

local DIRECTIONS = {
	{x = 1, y = 0},
	{x = 0, y = 1},
	{x = 1, y = 1},
	{x = 1, y = -1}
}

local SCORE = {
	WIN = 10000000,
	BLOCK_WIN = 5000000,
	OPEN_FOUR = 100000,
	BLOCK_FOUR = 80000,
	FOUR = 30000,
	OPEN_THREE = 8000,
	BLOCK_THREE = 6000,
	THREE = 1500,
	OPEN_TWO = 300,
	TWO = 50,
	CENTER = 25,           -- Збільшений бонус за центр дошки
	CORNER_PENALTY = -50   -- Штраф за занадто ранню гру в кутах або біля країв
}

local function CloneBoard(boardState, size)
	local board = {}
	for x = 1, size do
		board[x] = {}
		for y = 1, size do
			board[x][y] = boardState.GetPiece(x, y)
		end
	end
	return board
end

local function Get(board, x, y)
	if board[x] then
		return board[x][y]
	end
	return nil
end

local function Set(board, x, y, piece)
	if board[x] then
		board[x][y] = piece
	end
end

local function Inside(size, x, y)
	return x >= 1 and x <= size and y >= 1 and y <= size
end

local function AnalyzeLine(board, size, x, y, dx, dy, piece)
	local count = 1
	local openEnds = 0

	local nx, ny = x + dx, y + dy
	while Inside(size, nx, ny) and Get(board, nx, ny) == piece do
		count += 1
		nx += dx
		ny += dy
	end
	if Inside(size, nx, ny) and Get(board, nx, ny) == nil then
		openEnds += 1
	end

	nx, ny = x - dx, y - dy
	while Inside(size, nx, ny) and Get(board, nx, ny) == piece do
		count += 1
		nx -= dx
		ny -= dy
	end
	if Inside(size, nx, ny) and Get(board, nx, ny) == nil then
		openEnds += 1
	end

	return count, openEnds
end

local function GenerateMoves(board, size)
	local moves = {}
	for x = 1, size do
		for y = 1, size do
			if Get(board, x, y) == nil then
				local near = false
				for nx = math.max(1, x - 2), math.min(size, x + 2) do
					for ny = math.max(1, y - 2), math.min(size, y + 2) do
						if Get(board, nx, ny) ~= nil then
							near = true
							break
						end
					end
					if near then break end
				end
				if near then
					table.insert(moves, {X = x, Y = y})
				end
			end
		end
	end

	if #moves == 0 then
		local center = math.ceil(size / 2)
		table.insert(moves, {X = center, Y = center})
	end

	return moves
end

local function GetPlayers(board, size)
	local players = {}
	for x = 1, size do
		for y = 1, size do
			local p = Get(board, x, y)
			if p ~= nil then
				players[p] = true
			end
		end
	end
	return players
end

function ImpossibleBot:GetMove(boardState, size, winLength)
	local board = CloneBoard(boardState, size)
	winLength = winLength or 5

	local myPiece = "O"
	if boardState.GetCurrentPiece then
		myPiece = boardState.GetCurrentPiece()
	end

	local moves = GenerateMoves(board, size)
	if #moves == 0 then
		return nil
	end

	local players = GetPlayers(board, size)
	local opponents = {}
	for p, _ in pairs(players) do
		if p ~= myPiece then
			table.insert(opponents, p)
		end
	end

	local bestMove = moves[1]
	local maxScore = -math.huge
	local center = math.ceil(size / 2)

	for _, move in ipairs(moves) do
		local moveScore = 0

		-- 1. Позиційна оцінка: Центр проти Країв/Кутів
		local distanceToCenter = math.abs(center - move.X) + math.abs(center - move.Y)
		moveScore += (size - distanceToCenter) * SCORE.CENTER

		-- Штраф за крайнє або кутове положення (на великих дошках типу 20х20)
		if move.X == 1 or move.X == size or move.Y == 1 or move.Y == size then
			moveScore += SCORE.CORNER_PENALTY
		end

		-- 2. Власна атака
		Set(board, move.X, move.Y, myPiece)
		for _, dir in ipairs(DIRECTIONS) do
			local count, open = AnalyzeLine(board, size, move.X, move.Y, dir.x, dir.y, myPiece)
			if count >= winLength then
				moveScore += SCORE.WIN
			elseif count == winLength - 1 and open >= 1 then
				moveScore += SCORE.OPEN_FOUR
			elseif count == winLength - 2 and open == 2 then
				moveScore += SCORE.OPEN_THREE
			end
		end
		Set(board, move.X, move.Y, nil)

		-- 3. Захист від усіх супротивників
		for _, opp in ipairs(opponents) do
			Set(board, move.X, move.Y, opp)
			for _, dir in ipairs(DIRECTIONS) do
				local count, open = AnalyzeLine(board, size, move.X, move.Y, dir.x, dir.y, opp)
				if count >= winLength then
					moveScore += SCORE.BLOCK_WIN
				elseif count == winLength - 1 and open >= 1 then
					moveScore += SCORE.BLOCK_FOUR
				elseif count == winLength - 2 and open == 2 then
					moveScore += SCORE.BLOCK_THREE
				end
			end
			Set(board, move.X, move.Y, nil)
		end

		if moveScore > maxScore then
			maxScore = moveScore
			bestMove = move
		end
	end

	return bestMove or moves[1]
end

 return ImpossibleBot]]></ProtectedString>
