					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local GameStateManager = {}


local state = "Playing"

local winner = nil



function GameStateManager.GetState()

	return state

end



function GameStateManager.CanMove()

	return state == "Playing"

end



function GameStateManager.EndGame(player)

	state = "GameOver"

	winner = player

end



function GameStateManager.GetWinner()

	return winner

end



function GameStateManager.Restart()

	state = "Playing"

	winner = nil

end



return GameStateManager]]></ProtectedString>
