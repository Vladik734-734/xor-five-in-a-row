					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">79a5339341b640480a6a155500004ae3</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX61EC28CA85ED4F96B8BCB163F0C946ED">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local WinChecker = {}

local BoardState = require(
	game.ReplicatedStorage.Core.BoardState
)

local WIN_LENGTH = 5

local Directions = {
	{1,0},
	{0,1},
	{1,1},
	{1,-1}
}

local function CollectDirection(x, z, dx, dz, player, cells)

	local nx = x + dx
	local nz = z + dz

	while BoardState.GetPiece(nx, nz) == player do

		table.insert(cells, { X = nx, Y = nz })

		nx += dx
		nz += dz

	end

end

-- Повертає: won (boolean), line (масив {X=,Y=} або nil)
function WinChecker.CheckWin(x, z, player)

	for _, dir in ipairs(Directions) do

		local line = { { X = x, Y = z } }

		CollectDirection(x, z, dir[1], dir[2], player, line)
		CollectDirection(x, z, -dir[1], -dir[2], player, line)

		if #line >= WIN_LENGTH then

			return true, line

		end

	end

	return false, nil

end

return WinChecker]]></ProtectedString>
