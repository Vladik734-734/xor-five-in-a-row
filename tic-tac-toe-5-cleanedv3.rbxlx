					<ProtectedString name="Source"><![CDATA[local TableUtil = {}


function TableUtil.Copy(tbl)

	local copy={}

	for k,v in tbl do

		copy[k]=v

	end

	return copy

end



function TableUtil.Count(tbl)

	local amount=0

	for _ in tbl do

		amount+=1

	end

	return amount

end



return TableUtil]]></ProtectedString>
