				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Maid = {}
Maid.__index = Maid


function Maid.new()

	return setmetatable({

		Tasks = {}

	},Maid)

end



function Maid:Add(taskObject)

	table.insert(
		self.Tasks,
		taskObject
	)

end



function Maid:Clean()

	for _,taskObject in self.Tasks do

		if typeof(taskObject) == "RBXScriptConnection" then

			taskObject:Disconnect()

		elseif typeof(taskObject) == "Instance" then

			taskObject:Destroy()

		elseif type(taskObject)=="function" then

			taskObject()

		end

	end


	table.clear(
		self.Tasks
	)

end


return Maid]]></ProtectedString>
