				<Item class="ModuleScript" referent="RBX0063D0CC96FF480B995211F6D099011E">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Elo = {}


function Elo.Calculate(
	ratingA,
	ratingB,
	result
)


	local expected =
		1 /
		(
			1 +
			10 ^
			(
				(ratingB-ratingA)
				/
				400
			)
		)



	local change =
		math.floor(
			32 *
			(result-expected)
		)



	return change

end



return Elo]]></ProtectedString>
