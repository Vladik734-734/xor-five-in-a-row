						<ProtectedString name="Source"><![CDATA[local CoinManager = {}



function CoinManager:Add(data,amount)


	data.Coins += amount


end




function CoinManager:Remove(data,amount)


	if data.Coins < amount then

		return false

	end



	data.Coins -= amount


	return true

end




function CoinManager:Get(data)


	return data.Coins

end



