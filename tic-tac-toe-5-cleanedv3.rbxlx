			<Item class="ModuleScript" referent="RBXA910136212D84740A651D2726979C77A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local MoveValidator = {}


local BoardState =
	require(
		game.ReplicatedStorage.Core.BoardState
	)



local SIZE = 20



function MoveValidator.IsInsideBoard(x,z)

	return x >= 1
		and z >= 1
		and x <= SIZE
		and z <= SIZE

end




function MoveValidator.CanPlace(x,z)


	if not MoveValidator.IsInsideBoard(x,z) then

		return false,"Outside board"

	end



	if not BoardState.IsEmpty(x,z) then

		return false,"Cell occupied"

	end



	return true,"Valid"

end



return MoveValidator]]></ProtectedString>
