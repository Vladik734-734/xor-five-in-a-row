				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">BoardManager</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">79a5339341b640480a6a155500003b16</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXB465F9F2B2754351A07C3B825E517AFD">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

-- Налаштування ролей та їх кольорів
local ROLES = {
	Admin = {
		Text = "ADMIN",
		ColorA = Color3.fromRGB(255, 50, 50),   -- Яскраво-червоний
		ColorB = Color3.fromRGB(255, 220, 50), -- Золото-жовтий
		IsRainbow = true,                      -- Прапорець для переливу
		SpecialUserIds = {
			--11270405270, -- Мій ID (як приклад)
			11111111,    -- ID першого друга-адміна
			22222222,    -- ID другого друга-адміна
		},
		SpecialNames = {
			--"Vladik734_official", -- Мій нік (як приклад)
			"AdminFriendOne",     -- Нік першого друга-адміна
			"AdminFriendTwo",     -- Нік другого друга-адміна
		}
	},
	Staff = {
		Text = "STAFF",
		ColorA = Color3.fromRGB(50, 150, 255),
		ColorB = Color3.fromRGB(50, 255, 200),
		IsRainbow = false,
		SpecialUserIds = { 
			11270405270, -- Мій ID (як приклад)
			33333333,    -- ID першого стаф-друга
			44444444,    -- ID другого стаф-друга
		},
		SpecialNames = {
			--"Vladik734_official", -- Мій нік (як приклад)
			"StaffFriendOne",     -- Нік першого стаф-друга
			"StaffFriendTwo",     -- Нік другого стаф-друга
		}
	},
	Noob = {
		Text = "NOOB",
		ColorA = Color3.fromRGB(150, 150, 150),
		ColorB = Color3.fromRGB(200, 200, 200),
		IsRainbow = false,
		SpecialUserIds = { 
			--11270405270, -- Мій ID (як приклад)
			55555555,    -- ID першого нуба
			66666666,    -- ID другого нуба
		},
		SpecialNames = {
			--"Vladik734_official", -- Мій нік (як приклад)
			"NoobPlayerOne",      -- Нік першого нуба
			"NoobPlayerTwo",      -- Нік другого нуба
		}
	},
	Banned = {
		Text = "BANNED",
		ColorA = Color3.fromRGB(200, 0, 0),
		ColorB = Color3.fromRGB(100, 0, 0),
		IsRainbow = false,
		SpecialUserIds = { 
			--11270405270, -- Мій ID (як приклад)
			77777777,    -- ID першого забаненого
			88888888,    -- ID другого забаненого
		},
		SpecialNames = {
			"Vladik734", -- Мій нік (як приклад)
			"BadPlayerOne",       -- Нік першого забаненого
			"BadPlayerTwo",       -- Нік другого забаненого
		}
	}
}

-- Функція визначення ролі для конкретного гравця
local function getPlayerRole(player)
	-- 1. Перевірка для ADMIN
	if ROLES.Admin.SpecialUserIds then
		for _, id in ipairs(ROLES.Admin.SpecialUserIds) do
			if player.UserId == id then return ROLES.Admin end
		end
	end
	if ROLES.Admin.SpecialNames then
		for _, name in ipairs(ROLES.Admin.SpecialNames) do
			if player.Name == name then return ROLES.Admin end
		end
	end

	-- 2. Перевірка для STAFF
	if ROLES.Staff.SpecialUserIds then
		for _, id in ipairs(ROLES.Staff.SpecialUserIds) do
			if player.UserId == id then return ROLES.Staff end
		end
	end
	if ROLES.Staff.SpecialNames then
		for _, name in ipairs(ROLES.Staff.SpecialNames) do
			if player.Name == name then return ROLES.Staff end
		end
	end

	-- 3. Перевірка для BANNED
	if ROLES.Banned.SpecialUserIds then
		for _, id in ipairs(ROLES.Banned.SpecialUserIds) do
			if player.UserId == id then return ROLES.Banned end
		end
	end
	if ROLES.Banned.SpecialNames then
		for _, name in ipairs(ROLES.Banned.SpecialNames) do
			if player.Name == name then return ROLES.Banned end
		end
	end

	-- 4. Перевірка для NOOB (або якщо вписані вручну)
	if ROLES.Noob.SpecialUserIds then
		for _, id in ipairs(ROLES.Noob.SpecialUserIds) do
			if player.UserId == id then return ROLES.Noob end
		end
	end
	if ROLES.Noob.SpecialNames then
		for _, name in ipairs(ROLES.Noob.SpecialNames) do
			if player.Name == name then return ROLES.Noob end
		end
	end

	-- За замовчуванням для всіх інших гравців — роль Noob
	return ROLES.Noob
end

-- Функція створення плашки над головою, яка буде видима всім
local function setupCharacter(character)
	local head = character:WaitForChild("Head", 5)
	if not head then return end

	-- Запобігаємо створенню дублікатів, якщо персонаж респавниться
	if head:FindFirstChild("RoleTagGui") then
		head.RoleTagGui:Destroy()
	end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then return end

	local role = getPlayerRole(player)

	-- Створюємо BillboardGui на сервері
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "RoleTagGui"
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 1.5, 0) -- Висота плашки над головою
	billboard.AlwaysOnTop = true                  -- Щоб текст було видно крізь стіни/інших гравців
	billboard.Parent = head

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = role.Text
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextSize = 28
	textLabel.Font = Enum.Font.FredokaOne        -- Жирний округлий шрифт (як на вашому скріншоті)
	textLabel.TextStrokeTransparency = 0.2       -- Чорна обводка тексту для читабельності
	textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	textLabel.Parent = billboard

	local gradient = Instance.new("UIGradient")
	gradient.Parent = textLabel

	if role.IsRainbow then
		-- Для адміністратора робимо красивий градієнт (старт кольорів)
		gradient.Color = ColorSequence.new(role.ColorA, role.ColorB)

		-- Запускаємо невеликий серверний потік (task.spawn), який плавно крутитиме кольори градієнта для ADMIN
		task.spawn(function()
			while billboard and billboard.Parent do
				local t = tick() * 2
				local hue = (t % 5) / 5
				gradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromHSV(hue, 1, 1)),
					ColorSequenceKeypoint.new(0.5, Color3.fromHSV((hue + 0.3) % 1, 1, 1)),
					ColorSequenceKeypoint.new(1, Color3.fromHSV((hue + 0.6) % 1, 1, 1))
				})
				task.wait(0.1) -- оновлення раз на 0.1 секунди на сервері навантаження не робить
			end
		end)
	else
		-- Звичайні стабільні кольори для інших ролей (наприклад, червоний для Banned)
		gradient.Color = ColorSequence.new(role.ColorA, role.ColorB)
	end
end

-- Автоматичне застосування для всіх, хто заходить у гру або респавниться
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(setupCharacter)
end)

-- На випадок, якщо скрипт завантажився пізніше, ніж гравці
for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		task.spawn(setupCharacter, player.Character)
	end
	player.CharacterAdded:Connect(setupCharacter)
end

print("SERVER ROLE SYSTEM INITIALIZED SUCCESSFULLY")]]></ProtectedString>
