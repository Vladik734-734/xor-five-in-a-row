					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Signal =
	require(
		script.Parent.Core.Signal
	)


local EventBus = {}


local events = {}



function EventBus:Get(name)


	if not events[name] then

		events[name] =
			Signal.new()

	end


	return events[name]

end



function EventBus:Fire(name,...)


	self:Get(name):Fire(...)


end



return EventBus]]></ProtectedString>
