		<Item class="Script" referent="RBX6C57D0FB25E7402A87523DFABACC00B1">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

------------------------------------------------
-- REMOTES (Безпечне створення/пошук)
------------------------------------------------

local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
if not Remotes then
	Remotes = Instance.new("Folder")
	Remotes.Name = "Remotes"
	Remotes.Parent = ReplicatedStorage
end

local function getOrCreateRemote(className, name)
	local remote = Remotes:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = Remotes
	end
	return remote
end

local PlaceMove = getOrCreateRemote("RemoteEvent", "PlaceMove")
local YourPiece = getOrCreateRemote("RemoteEvent", "YourPiece")
local TurnUpdate = getOrCreateRemote("RemoteEvent", "TurnUpdate")
local GameResult = getOrCreateRemote("RemoteEvent", "GameResult")
local RestartGame = getOrCreateRemote("RemoteEvent", "RestartGame")
local SendBotsInfo = getOrCreateRemote("RemoteEvent", "SendBotsInfo")
local SetBotDifficulty = getOrCreateRemote("RemoteEvent", "SetBotDifficulty")
local SetWinSound = getOrCreateRemote("RemoteEvent", "SetWinSound")

------------------------------------------------
-- MODULES
------------------------------------------------

local Constants = require(ReplicatedStorage.Core.Constants)
local BoardState = require(ReplicatedStorage.Core.BoardState)
local MoveValidator = require(ReplicatedStorage.Core.MoveValidator)
local TurnManager = require(ReplicatedStorage.Core.TurnManager)
local PieceManager = require(ReplicatedStorage.Core.PieceManager)
local WinChecker = require(ReplicatedStorage.Core.WinChecker)
local GameStateManager = require(ReplicatedStorage.Core.GameStateManager)
local BotManager = require(ReplicatedStorage.Modules.Bots.BotManager)
local BotDifficulty = require(ReplicatedStorage.Modules.Bots.BotDifficulty)
local BotAvatar = require(ReplicatedStorage.Modules.Bots.BotAvatar)

------------------------------------------------
-- SETTINGS
------------------------------------------------

local BOT_THINK_TIME = 0.5
local BOT_FILL_DELAY = 5
local BOT_NAMES = { "Bot_Alpha", "Bot_Beta" }

local DEFAULT_BOT_DIFFICULTY = BotDifficulty.Impossible

local VALID_BOT_DIFFICULTIES = {
	[BotDifficulty.Easy] = true,
	[BotDifficulty.Medium] = true,
	[BotDifficulty.Hard] = true,
	[BotDifficulty.Impossible] = true
}

local HIGHLIGHT_COLOR = Color3.fromRGB(255, 215, 0)
local HIGHLIGHT_PULSE_COLOR = Color3.fromRGB(255, 255, 255)

-- Колір для підсвітки клітинки останнього ходу
local LAST_CELL_COLOR = Color3.fromRGB(255, 240, 100)

local BOT_AVATAR_COLORS = {
	O = Constants.COLORS.O,
	Rune = Constants.COLORS.RUNE,
}

------------------------------------------------
-- SOUND SETTINGS
------------------------------------------------

local WIN_SOUNDS = {
	Classic = "rbxassetid://9114220035",
	Victory = "rbxassetid://4590657391",
	Epic = "rbxassetid://6022835112",
	Retro   = "rbxassetid://6023426915"
}

local playerWinSounds = {}

SetWinSound.OnServerEvent:Connect(function(player, soundName)
	if WIN_SOUNDS[soundName] then
		playerWinSounds[player] = WIN_SOUNDS[soundName]
		print(player.Name, "set win sound to", soundName)
	end
end)

------------------------------------------------
-- STATE
------------------------------------------------

local PIECES = { "X", "O", "Rune" }

local playerToPiece = {}
local pieceToPlayer = {}
local pieceToBot = {}
local pieceToBotAvatar = {}

local totalCells = Constants.BOARD_SIZE * Constants.BOARD_SIZE
local movesPlayed = 0

local activeTweens = {}
local highlightedCellsOriginal = {} -- [cell] = { Color=, Material= }

-- Зберігаємо інформацію про останню підсвічену клітинку дошки
local lastCellInstance = nil
local lastCellOriginalData = nil

------------------------------------------------
-- IDLE TIMER (Таймер очікування ходу гравця)
------------------------------------------------

local idleCoroutine = nil
local IDLE_TIMEOUT = 15

local function cancelIdleTimer()
	if idleCoroutine then
		task.cancel(idleCoroutine)
		idleCoroutine = nil
	end
end

local function startIdleTimer()
	cancelIdleTimer()

	idleCoroutine = task.spawn(function()
		task.wait(IDLE_TIMEOUT)

		-- Безпечно шукаємо першого доступного бота і останню клітинку
		if pieceToBotAvatar and next(pieceToBotAvatar) then
			local _, targetBot = next(pieceToBotAvatar)
			if targetBot and lastCellInstance then
				-- Викликаємо візуальну фічу, не зачіпаючи серверні дані ходів
				BotAvatar.GoToCellAndJump(targetBot, lastCellInstance.Position)
			end
		end
	end)
end

------------------------------------------------
-- FORWARD DECLARATIONS
------------------------------------------------

local ProcessMove
local MaybeTriggerBotMove
local StartGame
local HighlightWinningLine
local ClearHighlights
local BroadcastBotsInfo

------------------------------------------------
-- HELPERS
------------------------------------------------

local function GetCell(x, z)

	local board = workspace:FindFirstChild("Board")
	local cells = board and board:FindFirstChild("Cells")

	return cells and cells:FindFirstChild("Cell_" .. x .. "_" .. z)

end

local function ClearPieces()

	local board = workspace:FindFirstChild("Board")
	local piecesFolder = board and board:FindFirstChild("Pieces")

	if piecesFolder then
		for _, piece in ipairs(piecesFolder:GetChildren()) do
			piece:Destroy()
		end
	end

end

local function GetPatrolWaypoints()

	local environment = workspace:WaitForChild("Environment", 10)

	if not environment then
		return nil
	end

	local envHalf = environment:GetAttribute("EnvHalf")
	local walkwayWidth = environment:GetAttribute("WalkwayWidth")
	local walkwayY = environment:GetAttribute("WalkwayY")

	if not (envHalf and walkwayWidth and walkwayY) then
		return nil
	end

	local radius = envHalf + walkwayWidth / 2

	return {
		Vector3.new(radius, walkwayY, radius),
		Vector3.new(radius, walkwayY, -radius),
		Vector3.new(-radius, walkwayY, -radius),
		Vector3.new(-radius, walkwayY, radius),
	}

end

------------------------------------------------
-- WORLD VICTORY BANNER (Ефект 3D-напису над головою)
------------------------------------------------
local function showWorldVictoryBanner(winningPlayer, winningPiece)
	local targetPart = nil

	-- Якщо перемиг реальний гравець, чіпаємо на голову його персонажа
	if winningPlayer and winningPlayer.Character then
		targetPart = winningPlayer.Character:FindFirstChild("Head")
	end

	-- Якщо це бот або персонажа немає, чіпаємо по центру дошки
	if not targetPart then
		local board = workspace:FindFirstChild("Board")
		targetPart = board and board:FindFirstChild("Base")
	end

	if not targetPart then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "WorldVictoryBanner"
	billboard.Size = UDim2.new(0, 300, 0, 80)
	billboard.StudsOffset = Vector3.new(0, 3, 0) -- Висота над головою
	billboard.AlwaysOnTop = true
	billboard.Parent = targetPart

	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = "WINNER!"
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.TextSize = 52
	textLabel.Font = Enum.Font.FredokaOne -- Наш улюблений фірмовий шрифт
	textLabel.TextStrokeTransparency = 0.2
	textLabel.TextStrokeColor3 = Color3.fromRGB(150, 70, 0)
	textLabel.Parent = billboard

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 100)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 200, 0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 130, 0))
	})
	gradient.Parent = textLabel

	-- Анімація переливу та автоматичне зникнення через 9 секунд
	task.spawn(function()
		local startTime = tick()
		while billboard and billboard.Parent do
			local elapsed = tick() - startTime
			if elapsed >= 9 then
				billboard:Destroy()
				break
			end

			local t = tick() * 9
			gradient.Offset = Vector2.new(math.sin(t) * 0.4, 0)

			task.wait(0.05)
		end
	end)
end

------------------------------------------------
-- WIN LINE HIGHLIGHT
------------------------------------------------

ClearHighlights = function()

	for _, tween in ipairs(activeTweens) do
		tween:Cancel()
	end

	table.clear(activeTweens)

	for cell, original in pairs(highlightedCellsOriginal) do

		if cell and cell.Parent then
			cell.Color = original.Color
			cell.Material = original.Material
		end

	end

	table.clear(highlightedCellsOriginal)

end

HighlightWinningLine = function(line)

	if not line then
		return
	end

	for _, coord in ipairs(line) do

		local cell = GetCell(coord.X, coord.Y)

		if cell and not highlightedCellsOriginal[cell] then

			highlightedCellsOriginal[cell] = {
				Color = cell.Color,
				Material = cell.Material
			}

			cell.Material = Enum.Material.Neon
			cell.Color = HIGHLIGHT_COLOR

			local tween = TweenService:Create(
				cell,
				TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ Color = HIGHLIGHT_PULSE_COLOR }
			)

			tween:Play()

			table.insert(activeTweens, tween)

		end

	end

end

------------------------------------------------
-- BOT INFO BROADCAST
------------------------------------------------

BroadcastBotsInfo = function()

	local oBot = pieceToBot["O"]
	local runeBot = pieceToBot["Rune"]

	SendBotsInfo:FireAllClients(
		oBot and oBot.Name or nil,
		oBot and oBot.Difficulty or nil,
		runeBot and runeBot.Name or nil,
		runeBot and runeBot.Difficulty or nil
	)

end

------------------------------------------------
-- PLAYER <-> PIECE ASSIGNMENT
------------------------------------------------

local function AssignPiece(player)

	for _, piece in ipairs(PIECES) do

		if not pieceToPlayer[piece] and not pieceToBot[piece] then

			playerToPiece[player] = piece
			pieceToPlayer[piece] = player

			YourPiece:FireClient(player, piece)

			print(player.Name, "assigned piece:", piece)

			BroadcastBotsInfo()

			return
		end
	end

	print(player.Name, "joined as spectator (all slots taken)")

	BroadcastBotsInfo()

end

local function ReleasePiece(player)

	local piece = playerToPiece[player]

	if piece then
		pieceToPlayer[piece] = nil
		playerToPiece[player] = nil
	end

end

Players.PlayerAdded:Connect(AssignPiece)
Players.PlayerRemoving:Connect(function(player)
	local piece = playerToPiece[player]

	ReleasePiece(player)

	if piece then
		print(player.Name, "left the match. Filling their slot (" .. piece .. ") with a bot...")

		local botIndex = (piece == "O") and 1 or 2
		local botName = BOT_NAMES[botIndex] or ("Bot_" .. piece)

		pieceToBot[piece] = BotManager:Create(botName, DEFAULT_BOT_DIFFICULTY)

		local waypoints = GetPatrolWaypoints()
		local color = BOT_AVATAR_COLORS[piece]
		if waypoints and color then
			pieceToBotAvatar[piece] = BotAvatar.Spawn(botName, color, waypoints, botIndex)
		end

		BroadcastBotsInfo()

		if TurnManager.GetCurrentPlayer() == piece then
			MaybeTriggerBotMove(piece)
		end
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	AssignPiece(player)
end

------------------------------------------------
-- BOTS
------------------------------------------------

MaybeTriggerBotMove = function(piece)

	local bot = pieceToBot[piece]

	if not bot then
		return
	end

	task.delay(BOT_THINK_TIME, function()

		if not GameStateManager.CanMove() then
			return
		end

		if TurnManager.GetCurrentPlayer() ~= piece then
			return
		end

		local move = BotManager:GetMove(bot, BoardState, Constants.BOARD_SIZE)

		if not move then
			return
		end

		ProcessMove(piece, move.X, move.Y)

	end)

end

local function FillEmptySlotsWithBots()

	local botIndex = 0
	local waypoints = GetPatrolWaypoints()

	for _, piece in ipairs(PIECES) do

		if not pieceToPlayer[piece] and not pieceToBot[piece] then

			botIndex += 1

			local botName = BOT_NAMES[botIndex] or ("Bot_" .. piece)

			pieceToBot[piece] = BotManager:Create(botName, DEFAULT_BOT_DIFFICULTY)

			print(botName, "filled empty slot:", piece)

			local color = BOT_AVATAR_COLORS[piece]

			if waypoints and color then
				pieceToBotAvatar[piece] = BotAvatar.Spawn(botName, color, waypoints, botIndex)
			end

		end

	end

	BroadcastBotsInfo()

	MaybeTriggerBotMove(TurnManager.GetCurrentPlayer())

end

------------------------------------------------
-- BOT DIFFICULTY SELECTION
------------------------------------------------

SetBotDifficulty.OnServerEvent:Connect(function(player, piece, difficulty)

	if typeof(piece) ~= "string" or typeof(difficulty) ~= "string" then
		return
	end

	if not VALID_BOT_DIFFICULTIES[difficulty] then
		warn(player.Name, "sent an invalid bot difficulty:", tostring(difficulty))
		return
	end

	local bot = pieceToBot[piece]

	if not bot then
		warn(player.Name, "tried to set difficulty for a non-bot piece:", tostring(piece))
		return
	end

	bot.Difficulty = difficulty

	print(player.Name, "set", piece, "bot difficulty to", difficulty)

	BroadcastBotsInfo()

end)

------------------------------------------------
-- MOVE PROCESSING
------------------------------------------------

ProcessMove = function(piece, x, z)

	if not GameStateManager.CanMove() then
		return false
	end

	local allowed, reason = MoveValidator.CanPlace(x, z)

	if not allowed then
		warn("Move rejected:", reason)
		return false
	end

	if not BoardState.SetPiece(x, z, piece) then
		return false
	end

	local cell = GetCell(x, z)

	if not cell then
		warn("Cell instance not found for", x, z)
		return false
	end

	PieceManager.CreatePiece(piece, cell.Position)

	------------------------------------------------
	-- ПІДСВІТКА КЛІТИНКИ ОСТАННЬОГО ХОДУ
	------------------------------------------------
	if lastCellInstance and lastCellInstance.Parent and not highlightedCellsOriginal[lastCellInstance] then
		if lastCellOriginalData then
			lastCellInstance.Color = lastCellOriginalData.Color
			lastCellInstance.Material = lastCellOriginalData.Material
		end
	end

	if not highlightedCellsOriginal[cell] then
		lastCellOriginalData = {
			Color = cell.Color,
			Material = cell.Material
		}
		cell.Color = LAST_CELL_COLOR
	end

	lastCellInstance = cell
	------------------------------------------------

	movesPlayed += 1

	------------------------------------------------
	-- CHECK WIN
	------------------------------------------------

	local win, winLine = WinChecker.CheckWin(x, z, piece)

	if win then

		GameStateManager.EndGame(piece)

		local winningPlayer = pieceToPlayer[piece]
		local soundId = (winningPlayer and playerWinSounds[winningPlayer]) or WIN_SOUNDS.Classic

		GameResult:FireAllClients(piece, winLine, soundId)
		HighlightWinningLine(winLine)

		-- ВИКЛИКАЄМО НАШ 3D-БАНЕР НАД ГОЛОВОЮ ПЕРЕМОЖЦЯ:
		showWorldVictoryBanner(winningPlayer, piece)

		print("====================")
		print(piece, "WINS!")
		print("====================")

		return true
	end

	------------------------------------------------
	-- CHECK DRAW
	------------------------------------------------

	if movesPlayed >= totalCells then

		GameStateManager.EndGame("Draw")
		GameResult:FireAllClients("Draw")

		print("====================")
		print("DRAW! Board is full.")
		print("====================")

		return true
	end

	------------------------------------------------
	-- NEXT TURN
	------------------------------------------------

	local nextPiece = TurnManager.NextTurn()

	TurnUpdate:FireAllClients(nextPiece)

	print("NEXT TURN:", nextPiece)

	MaybeTriggerBotMove(nextPiece)

	return true

end

------------------------------------------------
-- START / RESTART GAME
------------------------------------------------

StartGame = function()

	ClearHighlights()

	BoardState.Init()
	TurnManager.Reset()
	GameStateManager.Restart()
	ClearPieces()

	lastCellInstance = nil
	lastCellOriginalData = nil

	movesPlayed = 0

	TurnUpdate:FireAllClients(TurnManager.GetCurrentPlayer())

	print("GAME MANAGER STARTED")

	MaybeTriggerBotMove(TurnManager.GetCurrentPlayer())

end

StartGame()

task.delay(BOT_FILL_DELAY, FillEmptySlotsWithBots)

------------------------------------------------
-- PLAYER MOVE
------------------------------------------------

PlaceMove.OnServerEvent:Connect(function(player, x, z)

	if not GameStateManager.CanMove() then
		warn("Game already finished")
		return
	end

	if typeof(x) ~= "number" or typeof(z) ~= "number" then
		warn("Invalid move payload from", player.Name)
		return
	end

	local currentPiece = TurnManager.GetCurrentPlayer()

	if playerToPiece[player] ~= currentPiece then
		warn(player.Name, "tried to move out of turn")
		return
	end

	print(player.Name, "plays", currentPiece, x, z)

	ProcessMove(currentPiece, x, z)

end)

------------------------------------------------
-- RESTART
------------------------------------------------

RestartGame.OnServerEvent:Connect(function(player)
	StartGame()
end)]]></ProtectedString>
