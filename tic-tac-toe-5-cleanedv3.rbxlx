					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="RBXDA56175B302F4356BFE7428473E600C2">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Match</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">53b90d59c6f66e400a6886d0000012af</UniqueId>
				</Properties>
				<Item class="ModuleScript" referent="RBX21EBE7E628B34527AD7CA7ADF19E3A41">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local State =
	require(
		game.ReplicatedStorage.Core.StateManager
	)


local Board =
	require(
		script.Parent.Parent.Board.BoardManager
	)



local MatchManager={}



function MatchManager:Start(players)


	self.Players = players


	Board:Create()


	State:Set("Playing")


	print(
		"Match started"
	)

end




function MatchManager:Finish(winner)


	State:Set("Finished")


	print(
		"Winner:",
		winner.Name
	)

end



return MatchManager]]></ProtectedString>
						<string name="ScriptGuid">{AC364EB5-84FA-418B-8E32-100C89D3D364}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">MatchManager</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">53b90d59c6f66e400a6886d0000012b0</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX28242F756E7241698740E803FA8CA44E">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Timer = {}

Timer.ActiveTimers = {}



function Timer:Start(id,time,callback)


	self.ActiveTimers[id] = true


	task.spawn(function()


		local remaining = time


		while remaining > 0 
			and self.ActiveTimers[id]
		do


			task.wait(1)


			remaining -= 1


		end



		if self.ActiveTimers[id] then


			self.ActiveTimers[id] = nil


			if callback then

				callback()

			end


		end


	end)

end




function Timer:Stop(id)

	self.ActiveTimers[id] = nil

end




function Timer:IsRunning(id)

	return self.ActiveTimers[id] == true

end


return Timer]]></ProtectedString>
