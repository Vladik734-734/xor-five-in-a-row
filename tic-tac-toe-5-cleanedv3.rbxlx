				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local TurnManager = {}


local Pieces = {

	"X",
	"O",
	"Rune"

}


local index = 1



function TurnManager.GetCurrentPlayer()

	return Pieces[index]

end



function TurnManager.NextTurn()


	index += 1


	if index > #Pieces then

		index = 1

	end


	return Pieces[index]

end



function TurnManager.Reset()

	index = 1

end



return TurnManager]]></ProtectedString>
