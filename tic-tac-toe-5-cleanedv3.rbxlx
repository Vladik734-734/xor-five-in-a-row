						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local templates = ReplicatedStorage:WaitForChild("Templates")

local PieceTypes = require(
	ReplicatedStorage.Modules.Pieces.PieceTypes
)

local PieceFactory = {}

------------------------------------------------
-- SHARED SIZE SETTINGS
------------------------------------------------
-- Висота = як у старого X. Горизонтальний "відбиток" вдвічі менший (3 -> 1.5).

local HEIGHT = 0.5
local FOOTPRINT = 3

------------------------------------------------
-- X — дві діагональні планки (±45°)
------------------------------------------------

local function createX(color)

	local model = Instance.new("Model")
	model.Name = "X"
	
	local barLength = 4.5
	local barWidth = 0.35

	local p1 = Instance.new("Part")
	p1.Size = Vector3.new(barLength, HEIGHT, FOOTPRINT/5)
	p1.CFrame = CFrame.Angles(0, math.rad(45), 0)
	p1.Anchored = true
	p1.CanCollide = false
	p1.Material = Enum.Material.Metal
	p1.Color = color
	p1.Name = "Bar1"
	p1.Parent = model

	local p2 = p1:Clone()
	p2.CFrame = CFrame.Angles(0, math.rad(-45), 0)
	p2.Name = "Bar2"
	p2.Parent = model

	model.PrimaryPart = p1

	return model

end

------------------------------------------------
-- O — диск з реальною дірою (CSG subtract)
------------------------------------------------

local function createO(color)
	-- Клонуємо готову модель з шаблонів
	local template = templates:WaitForChild("O_Template")
	local model = template:Clone()
	model.Name = "O"

	-- Знаходимо основну деталь всередині моделі
	local primaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")

	if primaryPart then
		primaryPart.Color = Color3.fromRGB(255, 0, 0)
		primaryPart.Anchored = true
		primaryPart.CanCollide = false

		-- У майбутньому тут можна буде легко додавати скіни, наприклад:
		-- primaryPart.Material = skinData.Material
		-- primaryPart.TextureID = skinData.TextureID
	end

	return model
end

------------------------------------------------
-- Rune — ромб (квадрат, розвернений на 45°)
------------------------------------------------

local function createRune(color)

	local model = Instance.new("Model")
	model.Name = "Rune"

	local side = FOOTPRINT / math.sqrt(1.5)

	local part = Instance.new("Part")
	part.Size = Vector3.new(side, HEIGHT, side)
	part.CFrame = CFrame.Angles(0, math.rad(45), 0)
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Glass
	part.Color = color
	part.Name = "Part"
	part.Parent = model

	model.PrimaryPart = part

	return model

end

------------------------------------------------

function PieceFactory.Create(pieceId)

	local info = PieceTypes:GetById(pieceId)

	if not info then
		return nil
	end

	if pieceId == 1 then
		return createX(info.Color)
	end

	if pieceId == 2 then
		return createO(info.Color)
	end

	if pieceId == 3 then
		return createRune(info.Color)
	end

	return nil

end

return PieceFactory]]></ProtectedString>
