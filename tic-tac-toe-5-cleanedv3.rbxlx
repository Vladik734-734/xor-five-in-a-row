				<Item class="ModuleScript" referent="RBXCB448E9D6EC24171A661B0B2D03D82E4">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local MatchHistory = {}


local History = {}



function MatchHistory:Add(match)


	table.insert(
		History,
		{

			ID = #History + 1,

			Winner = match.Winner,

			Players = match.Players,

			Moves = match.Moves,

			Time = os.time()

		}
	)


end




function MatchHistory:GetLast(amount)


	local result={}


	for i =
		math.max(
			1,
			#History - amount + 1
		),
		#History
	do

		table.insert(
			result,
			History[i]
		)

	end


	return result

end



function MatchHistory:Clear()

	table.clear(
		History
	)

end



return MatchHistory]]></ProtectedString>
