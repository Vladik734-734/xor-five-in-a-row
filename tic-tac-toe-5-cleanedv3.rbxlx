						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Validation = {}



function Validation:IsNumber(value)


	return typeof(value)=="number"


end




function Validation:IsValidPosition(x,y,size)


	if not self:IsNumber(x)
		or not self:IsNumber(y) then

		return false

	end



	return x >=1
		and x <= size
		and y >=1
		and y <= size


end




function Validation:CanPlace(player,turnPlayer)


	return player == turnPlayer


end



return Validation]]></ProtectedString>
