					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local StatsManager = {}


function StatsManager:Create()

	return {

		Games = 0,

		Wins = 0,

		Losses = 0,

		Draws = 0,

		WinStreak = 0,

		BestWinStreak = 0,

		HighestRating = 1000,

		TotalMoves = 0

	}

end



function StatsManager:AddWin(stats)

	stats.Games += 1

	stats.Wins += 1

	stats.WinStreak += 1


	if stats.WinStreak > stats.BestWinStreak then

		stats.BestWinStreak =
			stats.WinStreak

	end

end




function StatsManager:AddLoss(stats)

	stats.Games += 1

	stats.Losses += 1

	stats.WinStreak = 0

end




function StatsManager:AddDraw(stats)

	stats.Games += 1

	stats.Draws += 1

	stats.WinStreak = 0

end




function StatsManager:UpdateRating(stats,rating)


	if rating > stats.HighestRating then

		stats.HighestRating =
			rating

	end

end



return StatsManager]]></ProtectedString>
						<string name="ScriptGuid">{2D2A098B-9D83-46DC-8244-9FFD9BE480FB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
